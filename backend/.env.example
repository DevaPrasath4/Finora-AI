# ==============================================================================
# FINGUARD AI BACKEND - CONFIGURATION TEMPLATE
# Copy this file to '.env' (in the backend directory) and fill in your values.
# ==============================================================================

PORT=5000
SUPABASE_ENABLED=true

# CORS Configuration
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Supabase Server/Admin Credentials
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# NVIDIA Vision AI Configuration (for OCR invoice extraction)
NVIDIA_API_KEY=nvapi-your-nvidia-developer-key
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Groq LLM API Keys for the 4 specialized AI agents
GROQ_API_KEY_FINANCE=gsk-finance-key
GROQ_API_KEY_INVENTORY=gsk-inventory-key
GROQ_API_KEY_VENDOR=gsk-vendor-key
GROQ_API_KEY_FRAUD_GROWTH=gsk-fraud-growth-key
