<!-- SECTION 17 -->
<h1>17. Database Structure (data.json)</h1>

<table>
  <tr><th>Table Name</th><th>Fields</th><th>Auto-Populated By</th></tr>
  <tr><td><code>users</code></td><td>id, user_id, company_name, mobile_number, email, password_hash, role, owner_id</td><td>Signup API</td></tr>
  <tr><td><code>invoices</code></td><td>id, user_id, invoice_number, supplier_name, grand_total, status, riskScore, items, created_at</td><td>Manual entry, OCR upload</td></tr>
  <tr><td><code>customer_bills</code></td><td>id, user_id, bill_number, customer_name, grand_total, status, due_date, items, created_at</td><td>POS checkout</td></tr>
  <tr><td><code>inventory</code></td><td>id, user_id, name, category, stockQty, minAlertThreshold, unitPrice, status, supplier</td><td>Manual add, Invoice upload</td></tr>
  <tr><td><code>expenses</code></td><td>id, user_id, category, amount, date, paidTo, status</td><td>Manual, Salary payout</td></tr>
  <tr><td><code>transactions</code></td><td>id, user_id, date, type (IN/OUT), description, category, amount, balance</td><td>POS sale, Bill settlement, Salary</td></tr>
  <tr><td><code>employees</code></td><td>id, user_id, name, role, phone, salary, salary_date, payment_status, payment_history</td><td>Add Employee</td></tr>
  <tr><td><code>vendors</code></td><td>id, user_id, name, contact, category, rating</td><td>Add Vendor</td></tr>
  <tr><td><code>fraud_alerts</code></td><td>id, user_id, type, message, severity, resolved, timestamp</td><td>Duplicate bill detection</td></tr>
  <tr><td><code>activity_logs</code></td><td>id, user_id, action, details, category, created_at</td><td>All write operations</td></tr>
  <tr><td><code>webhooks</code></td><td>id, eventType, source, referenceId, itemCount, timestamp, status</td><td>Stock webhook trigger</td></tr>
  <tr><td><code>settings</code></td><td>Keyed by shopId — business_profile, shop_info, security, app_preferences</td><td>Settings save</td></tr>
</table>

<hr>

